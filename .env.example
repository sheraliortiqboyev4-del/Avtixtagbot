# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telegram numeric ID of the bot administrator
ADMIN_ID=

# Backup encryption secret: use at least 16 characters
BACKUP_SECRET=

# Telegram StringSession for the admin account used by backups
# Leave empty if Telegram Saved Messages backup is not needed
ADMIN_SESSION=

# HTTP health server port
PORT=3000

# Optional settings
BOT_PROMO_USERNAME=@Foydasizku_bot
AUTH_USE_WSS=1
TG_DEVICE_MODEL=AvtoBotPro_v2
TG_SYSTEM_VERSION=Windows 10
TG_APP_VERSION=Telegram Desktop 1.0.0

# Optional Render self-ping
RENDER_EXTERNAL_URL=
RENDER_SERVICE_NAME=

# Optional MTProxy
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=443
TELEGRAM_PROXY_SECRET=

# Currently reserved; SQLite is used by the bot
DATABASE_URL=
